# =============================================================================
# Stream2Vec — Variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs
# NE JAMAIS committer le fichier .env
# =============================================================================

# --- Application ---
APP_NAME=Stream2Vec
APP_ENV=development  # development | staging | production
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stream2vec
POSTGRES_USER=stream2vec
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://stream2vec:change-me@postgres:5432/stream2vec

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=documents
MINIO_USE_SSL=false

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_DOCUMENTS=documents.raw
KAFKA_CONSUMER_GROUP=stream2vec-consumers

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_DOCUMENTS=documents

# --- Spark ---
SPARK_MASTER=spark://spark-master:7077
SPARK_APP_NAME=Stream2Vec

# --- Airflow ---
AIRFLOW_FERNET_KEY=change-me
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# --- Prometheus ---
PROMETHEUS_PORT=9090

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Logging ---
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text
