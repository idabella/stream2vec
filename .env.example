# =============================================================================
# Stream2Vec — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit the .env file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Stream2Vec
APP_ENV=development        # development | staging | production
APP_VERSION=0.1.0
DEBUG=true

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---------------------------------------------------------------------------
# PostgreSQL
# The single PostgreSQL instance hosts two databases:
#   - stream2vec  → application data (ORM models, metadata)
#   - airflow     → Airflow metadata (created by scripts/init-db.sh)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stream2vec
POSTGRES_USER=stream2vec
POSTGRES_PASSWORD=CHANGE_ME

# Async SQLAlchemy URL used by the FastAPI backend
DATABASE_URL=postgresql+asyncpg://stream2vec:CHANGE_ME@postgres:5432/stream2vec

# Airflow database credentials (created automatically by scripts/init-db.sh)
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_airflow

# ---------------------------------------------------------------------------
# MinIO — S3-compatible object storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password_min_8_chars
MINIO_BUCKET_DOCUMENTS=documents
MINIO_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Kafka — KRaft mode (no ZooKeeper)
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_DOCUMENTS=documents.raw
KAFKA_TOPIC_PROCESSING=documents.processing
KAFKA_TOPIC_COMPLETED=documents.completed
KAFKA_CONSUMER_GROUP=stream2vec-consumers
KAFKA_NUM_PARTITIONS=3

# KRaft cluster ID — generate once with:
#   docker run --rm confluentinc/cp-kafka:7.7.1 kafka-storage random-uuid
KAFKA_CLUSTER_ID=CHANGE_ME_generate_with_kafka_storage_random_uuid

# ---------------------------------------------------------------------------
# Qdrant — Vector database
# ---------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_DOCUMENTS=documents

# Leave empty for local development (no authentication).
# Required for Qdrant Cloud deployments.
QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Apache Spark — Structured Streaming
# ---------------------------------------------------------------------------
SPARK_MASTER=spark://spark-master:7077
SPARK_APP_NAME=Stream2Vec
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2

# ---------------------------------------------------------------------------
# Apache Airflow
# ---------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Fernet key for encrypting sensitive data stored in the Airflow metadata DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_generate_with_fernet

# Secret key for the Airflow webserver session and CSRF tokens.
# Generate with: openssl rand -hex 32
AIRFLOW_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Airflow admin user (created on first startup)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_airflow_admin
AIRFLOW_ADMIN_EMAIL=admin@stream2vec.local
AIRFLOW_PORT=8088

# ---------------------------------------------------------------------------
# Prometheus
# ---------------------------------------------------------------------------
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin

# ---------------------------------------------------------------------------
# Google Gemini (RAG chat)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json            # json | text
