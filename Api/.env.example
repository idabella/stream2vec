# Stream2Vec Backend — Environment Variables
# Copy to .env and configure

APP_NAME=Stream2Vec
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

API_V1_PREFIX=/api/v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stream2vec
POSTGRES_USER=stream2vec
POSTGRES_PASSWORD=stream2vec_password
DATABASE_URL=postgresql+asyncpg://stream2vec:stream2vec_password@postgres:5432/stream2vec

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_PROCESSED=processed
MINIO_SECURE=false

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_DOCUMENTS=documents.uploaded
KAFKA_TOPIC_PROCESSED=documents.processed
KAFKA_TOPIC_FAILED=documents.failed
KAFKA_CONSUMER_GROUP=stream2vec-group

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

LOG_LEVEL=INFO
LOG_FORMAT=json
